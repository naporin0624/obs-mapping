---
import { HEX_STROKE, HEX_VIEWBOX, hexCenters, hexOutline } from './hex-thumb';

const points = (outline: [number, number][]): string => outline.map(([x, y]) => `${x.toFixed(1)},${y.toFixed(1)}`).join(' ');
---

<svg
  viewBox={`0 0 ${String(HEX_VIEWBOX.width)} ${String(HEX_VIEWBOX.height)}`}
  fill="none"
  stroke="currentColor"
  stroke-width={HEX_STROKE}
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
>
  {hexCenters().map((center) => <polygon points={points(hexOutline(center))} />)}
</svg>

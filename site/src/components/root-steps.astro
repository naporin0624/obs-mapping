---
import { css } from '../../styled-system/css';
import { localePath, messagesFor, type Lang } from '../i18n/messages';

type Props = { lang: Lang };

const { lang } = Astro.props;
const { how } = messagesFor(lang).root;

const list = css({
  margin: 0,
  paddingLeft: '1.5em',
  '& h3': { margin: 0, fontSize: '1.125rem', lineHeight: '1.5' },
  '& p': { margin: '4px 0 0' },
  '& li::marker': { color: 'fg.muted', fontWeight: 700 },
});
---

<ol class={list}>
  <li>
    <h3>{how.map.title}</h3>
    <p>{how.map.body}</p>
    <p><a href={localePath(lang, '/demo/')}>{how.map.demos}</a></p>
  </li>
</ol>

---
import { css } from '../../styled-system/css';
import { localePath, messagesFor, type Lang } from '../i18n/messages';
import type { DemoSlug } from '../scene/spec';
import { scenes } from '../demos';

type Props = { lang: Lang; slug: DemoSlug };

const { lang, slug } = Astro.props;
const t = messagesFor(lang);
const demo = t.demos[slug];
const { steps } = scenes[slug];
const stepNumber = (i: number): string => String(i + 1).padStart(2, '0');
const finalStep = steps.at(-1);

const viewer = css({
  display: 'grid',
  gridTemplateColumns: 'minmax(0, 1fr)',
  '@media (width >= 900px)': { gridTemplateColumns: 'minmax(0, 1fr) 360px', height: '100%' },
});
const stage = css({
  position: 'relative',
  height: '56dvh',
  minHeight: '240px',
  background: 'bg.emphasis',
  _focusVisible: { outlineOffset: '-2px' },
  '& canvas': { display: 'block', width: '100%', height: '100%', touchAction: 'none' },
  '@media (width >= 900px)': { height: '100%' },
});
const fallback = css({ display: 'grid', placeItems: 'center', height: '100%', margin: 0, padding: '16px', textAlign: 'center' });
const hint = css({
  position: 'absolute',
  bottom: '8px',
  left: '8px',
  maxWidth: 'calc(100% - 16px)',
  margin: 0,
  padding: '2px 8px',
  background: 'bg.canvas',
  color: 'fg.muted',
  fontSize: '0.75rem',
  pointerEvents: 'none',
});
const visuallyHidden = css({ position: 'absolute', width: '1px', height: '1px', overflow: 'hidden', clipPath: 'inset(50%)', whiteSpace: 'nowrap' });
const panel = css({
  display: 'grid',
  alignContent: 'start',
  gap: '24px',
  padding: '20px 16px 32px',
  background: 'bg.subtle',
  borderTop: '{borderWidths.default} solid {colors.border.subtle}',
  overflowWrap: 'anywhere',
  '& legend': { padding: 0 },
  '& h2': { margin: '0 0 2px', color: 'fg.muted', fontSize: '0.75rem', fontWeight: 700, letterSpacing: '0.12em' },
  '@media (width >= 900px)': { overflowY: 'auto', borderTop: 0, borderLeft: '{borderWidths.default} solid {colors.border.subtle}' },
});
const intro = css({ '& h1': { margin: 0, fontSize: '1.5rem', lineHeight: '1.3' } });
const crumb = css({ margin: '0 0 4px', '& a': { display: 'inline-flex', alignItems: 'center', minHeight: 'target-min' } });
const lead = css({ margin: '4px 0 0', color: 'fg.muted', fontSize: '0.875rem' });
const group = css({ display: 'grid', gap: '10px', minWidth: 0, margin: 0, padding: 0, border: 0 });
const seg = css({
  display: 'grid',
  gridTemplateColumns: '1fr 1fr',
  border: '{borderWidths.default} solid {colors.border.default}',
  '& label': { position: 'relative', display: 'grid', placeItems: 'center', minHeight: '40px', padding: '4px 8px', textAlign: 'center', fontSize: '0.875rem', cursor: 'pointer' },
  '& label + label': { borderLeft: '{borderWidths.default} solid {colors.border.default}' },
  '& input': { position: 'absolute', inset: 0, margin: 0, opacity: 0, cursor: 'pointer' },
  '& label:has(input:checked)': { background: 'fg.default', color: 'bg.canvas', fontWeight: 700 },
  '& label:has(input:focus-visible)': { outline: '{borderWidths.strong} solid {colors.border.focus}', outlineOffset: '2px' },
  'fieldset:disabled & label': { opacity: 'disabled', cursor: 'not-allowed' },
});
const device = css({
  display: 'grid',
  gap: '4px',
  fontSize: '0.875rem',
  '& select': { minHeight: 'target-min', padding: '6px 8px', border: '{borderWidths.default} solid {colors.border.default}', background: 'bg.canvas', color: 'fg.default', font: 'inherit' },
});
const note = css({ margin: 0, color: 'fg.muted', fontSize: '0.8125rem' });
const secondary = css({ justifySelf: 'start', background: 'transparent', color: 'accent.text', _hover: { background: 'bg.muted', color: 'accent.text' } });
const choice = { width: '16px', height: '16px', margin: 0, accentColor: 'accent.solid' };
const stepList = css({
  display: 'grid',
  gap: '6px',
  margin: 0,
  padding: 0,
  listStyle: 'none',
  '& label': { display: 'flex', alignItems: 'center', gap: '8px', minHeight: '32px', cursor: 'pointer' },
  '& input': choice,
  '& li:has(input:checked) label': { fontWeight: 700 },
  'fieldset:disabled & label': { opacity: 'disabled', cursor: 'not-allowed' },
});
const stepIndex = css({ color: 'fg.subtle', fontFamily: 'mono', fontSize: '0.8125rem' });
const stepBody = css({
  margin: '0 0 4px 24px',
  paddingLeft: '12px',
  borderLeft: '{borderWidths.strong} solid {colors.accent.border}',
  color: 'fg.muted',
  fontSize: '0.8125rem',
  'li:not(:has(input:checked)) > &': { display: 'none' },
});
const check = css({ display: 'flex', alignItems: 'center', gap: '8px', minHeight: 'target-min', fontSize: '0.875rem', cursor: 'pointer', '& input': choice });
const connect = css({
  display: 'grid',
  gap: '10px',
  margin: 0,
  padding: '0 0 0 1.4em',
  color: 'fg.muted',
  fontSize: '0.875rem',
  '& .button': { display: 'inline-flex', alignItems: 'center', marginBottom: '6px' },
});
---

<div class={viewer} data-demo-viewer={slug}>
  <div class={stage} data-stage tabindex="0" role="group" aria-label={t.viewer.stage} aria-describedby="viewer-hint">
    <canvas data-stage-canvas role="img" aria-label={`${demo.title}: ${demo.description}`}></canvas>
    <p class={fallback} data-webgl-fallback hidden>{t.webglFallback}</p>
    <p class={hint} id="viewer-hint" data-hint>
      {t.viewer.hint}<span class={visuallyHidden}>{t.viewer.keys}</span>
    </p>
  </div>

  <aside class={panel}>
    <header class={intro}>
      <p class={crumb}><a href={localePath(lang, '/demo/')}>{t.demoIndex.title}</a></p>
      <h1>{demo.title}</h1>
      <p class={lead}>{demo.description}</p>
    </header>

    <fieldset class={group} data-input>
      <legend><h2>{t.viewer.input.heading}</h2></legend>
      <div class={seg}>
        <label><input type="radio" name="source" value="sample" checked data-source-radio />{t.viewer.input.sample}</label>
        <label><input type="radio" name="source" value="obs" data-source-radio />{t.viewer.input.obs}</label>
      </div>
      <label class={device} data-device-field hidden>
        <span>{t.viewer.input.device}</span>
        <select data-device></select>
      </label>
      <p
        class={note}
        role="status"
        aria-live="polite"
        data-camera-status
        data-join={t.camera.join}
        data-switch-failed={t.camera.switchFailed}
        data-unnamed={t.viewer.input.unnamed}
        data-sample={t.camera.sample}
        data-requesting={t.camera.requesting}
        data-waiting={t.camera.waiting}
        data-obs={t.camera.obs}
        data-other={t.camera.other}
        data-letterbox={t.camera.letterbox}
        data-denied={t.camera.denied}
        data-unavailable={t.camera.unavailable}
        data-busy={t.camera.busy}
        data-disconnected={t.camera.disconnected}
      >
        {t.camera.sample}
      </p>
      <button type="button" class={secondary} data-sample-toggle data-pause={t.sample.pause} data-play={t.sample.play}>{t.sample.pause}</button>
    </fieldset>

    <fieldset class={group} data-steps>
      <legend><h2>{t.viewer.steps.heading}</h2></legend>
      <p class={note} data-steps-locked hidden>{t.viewer.steps.locked}</p>
      <ol class={stepList}>
        {
          steps.map((id, i) => {
            const copy = t.step(slug, id);
            return (
              <li>
                <label>
                  <input type="radio" name="step" value={id} checked={id === finalStep} data-step-radio />
                  <span class={stepIndex} aria-hidden="true">
                    {stepNumber(i)}
                  </span>
                  <span>{copy.title}</span>
                </label>
                <p class={stepBody}>{copy.body}</p>
              </li>
            );
          })
        }
      </ol>
    </fieldset>

    <section class={group} aria-labelledby="view-heading">
      <h2 id="view-heading">{t.viewer.view.heading}</h2>
      <label class={check}><input type="checkbox" checked data-beam />{t.viewer.view.beam}</label>
      <button type="button" class={secondary} data-reset-view>{t.viewer.view.reset}</button>
    </section>

    <section class={group} aria-labelledby="connect-heading">
      <h2 id="connect-heading">{t.viewer.connect.heading}</h2>
      <ol class={connect}>
        <li>
          <a class="button" href={`/demo/${slug}.mapping.json`} download={`surface-mapper-demo-${slug}.json`}>{t.download.label}</a>
          <p class={note}>{t.download.note}</p>
        </li>
        <li>{t.viewer.connect.importIt}</li>
        <li>{t.viewer.connect.startCamera}</li>
        <li>{t.viewer.connect.chooseHere}</li>
      </ol>
    </section>
  </aside>
</div>

<script>
  import { mountDemoViewer } from './demo-viewer.client';

  mountDemoViewer(document);
</script>


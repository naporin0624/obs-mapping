---
import { Picture } from 'astro:assets';
import { css } from '../../styled-system/css';
import thumbnail from '../assets/brand/thumbnail.png';
import { localePath, messagesFor, type Lang } from '../i18n/messages';
import ExternalLink from './external-link.astro';
import RootSkills from './root-skills.astro';
import RootSteps from './root-steps.astro';

type Props = { lang: Lang };

const GITHUB_URL = 'https://github.com/naporin0624/obs-mapping';
const RELEASES_URL = `${GITHUB_URL}/releases/latest`;
const { lang } = Astro.props;
const t = messagesFor(lang);

const root = css({
  maxWidth: '48rem',
  margin: '0 auto',
  padding: '24px 16px 64px',
  '& h1': { margin: '24px 0 0', fontSize: '2.5rem', lineHeight: '1.3' },
  '& h2': { margin: '0 0 16px', paddingTop: '16px', borderTop: '{borderWidths.default} solid {colors.border.subtle}', fontSize: '1.5rem', lineHeight: '1.4' },
});
const hero = css({ display: 'block', width: '100%', height: 'auto', background: 'bg.emphasis' });
const lead = css({ margin: '8px 0 0', color: 'fg.muted', fontSize: '1.125rem' });
const actions = css({
  display: 'flex',
  flexWrap: 'wrap',
  alignItems: 'center',
  gap: '16px 24px',
  margin: '24px 0 0',
  '& a': { display: 'inline-flex', alignItems: 'center', minHeight: 'target-min' },
});
const section = css({ marginTop: '56px' });
const bullets = css({ display: 'grid', gap: '8px', margin: 0, paddingLeft: '1.5em' });
const links = css({
  display: 'flex',
  flexWrap: 'wrap',
  gap: '8px 24px',
  margin: '16px 0 0',
  '& a': { display: 'inline-flex', alignItems: 'center', minHeight: 'target-min' },
});
---

<div class={root}>
  <Picture
    class={hero}
    src={thumbnail}
    formats={['avif', 'webp']}
    fallbackFormat="jpg"
    widths={[480, 768, 1152, 1536]}
    sizes="(width >= 800px) 768px, calc(100vw - 32px)"
    loading="eager"
    fetchpriority="high"
    alt=""
  />
  <h1>{t.root.title}</h1>
  <p class={lead}>{t.root.description}</p>
  <p class={actions}>
    <ExternalLink lang={lang} class="button" href={RELEASES_URL}>{t.root.getPlugin}</ExternalLink>
    <a href={localePath(lang, '/demo/')}>{t.root.demos}</a>
  </p>

  <section class={section} aria-labelledby="can">
    <h2 id="can">{t.root.can.heading}</h2>
    <ul class={bullets}>{t.root.can.items.map((item) => <li>{item}</li>)}</ul>
  </section>

  <section class={section} aria-labelledby="how">
    <h2 id="how">{t.root.how.heading}</h2>
    <RootSteps lang={lang} />
  </section>

  <section class={section} aria-labelledby="skills">
    <h2 id="skills">{t.root.skills.heading}</h2>
    <RootSkills lang={lang} />
  </section>

  <section class={section} aria-labelledby="env">
    <h2 id="env">{t.root.env.heading}</h2>
    <ul class={bullets}>
      <li>{t.root.env.macos}</li>
      <li>{t.root.env.windows}</li>
      <li>{t.root.env.obs}</li>
    </ul>
    <p class={links}>
      <ExternalLink lang={lang} href={GITHUB_URL}>{t.root.github}</ExternalLink>
      <ExternalLink lang={lang} href={RELEASES_URL}>{t.root.releases}</ExternalLink>
    </p>
  </section>
</div>

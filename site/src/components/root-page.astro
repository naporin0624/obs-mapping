---
import { localePath, messagesFor, type Lang } from '../i18n/messages';

type Props = { lang: Lang };

const GITHUB_URL = 'https://github.com/naporin0624/obs-mapping';
const { lang } = Astro.props;
const t = messagesFor(lang);
---

<div class="root">
  <h1>{t.root.title}</h1>
  <p class="lead">{t.root.description}</p>
  <p class="actions">
    <a class="button" href={localePath(lang, '/demo/')}>{t.root.demos}</a>
    <a class="plain" href={GITHUB_URL}>{t.root.github}</a>
  </p>
</div>

<style>
  .root {
    max-width: 40rem;
    margin: 0 auto;
    padding: 64px 16px;
  }

  h1 {
    margin: 0;
    font-size: 2.5rem;
    line-height: 1.3;
  }

  .lead {
    color: var(--color-fg-muted);
    font-size: 1.125rem;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 16px 24px;
    margin-top: 32px;
  }

  .actions a {
    display: inline-flex;
    align-items: center;
    min-height: var(--size-target-min);
  }
</style>

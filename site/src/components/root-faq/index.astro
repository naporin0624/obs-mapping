---
import { messagesFor, type Lang } from '../../i18n/messages';
import ExternalLink from '../external-link.astro';
import { answerCls, groupCls, itemCls, linksCls } from './styles.css';

type Props = { lang: Lang };

const { lang } = Astro.props;
const { groups } = messagesFor(lang).root.faq;
const isExternal = (href: string): boolean => href.startsWith('http');
---

{
  groups.map((group) => (
    <div class={groupCls}>
      <h3>{group.heading}</h3>
      {group.items.map((item) => (
        <details class={itemCls} open={group.open}>
          <summary>{item.q}</summary>
          <div class={answerCls} id={item.id}>
            {item.a.map((paragraph) => <p>{paragraph}</p>)}
            {item.links && (
              <p class={linksCls}>
                {item.links.map((link) =>
                  isExternal(link.href) ? <ExternalLink lang={lang} href={link.href}>{link.label}</ExternalLink> : <a href={link.href}>{link.label}</a>,
                )}
              </p>
            )}
          </div>
        </details>
      ))}
    </div>
  ))
}

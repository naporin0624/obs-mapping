---
import { messagesFor, type Lang } from '../../i18n/messages';
import ExternalLink from '../external-link.astro';
import GuideRows from '../guide-rows/index.astro';
import { stepListCls } from '../styles.css';
import { warningsCls } from './styles.css';

type Props = { lang: Lang; releasesUrl: string };

const { lang, releasesUrl } = Astro.props;
const { install, guide } = messagesFor(lang).root;
const { download, run, open, connect } = install;
---

<ol class={stepListCls}>
  <li id="install-download" data-step>
    <h3>{download.title}</h3>
    <p>{download.body}</p>
    <p><ExternalLink lang={lang} href={releasesUrl}>{download.link}</ExternalLink></p>
  </li>
  <li id="install-run" data-step>
    <h3>{run.title}</h3>
    <p>{run.body}</p>
    <dl class={warningsCls}>
      <dt>macOS</dt>
      <dd>{run.macos}</dd>
      <dd>{run.macosOld}</dd>
      <dt>Windows</dt>
      <dd>{run.windows}</dd>
    </dl>
  </li>
  <li id="install-open" data-step>
    <h3>{open.title}</h3>
    <p>{open.body}</p>
    <GuideRows rows={open.rows} labels={guide} />
    <p><a href="#faq-dock">{open.faq}</a></p>
  </li>
  <li id="install-connect" data-step>
    <h3>{connect.title}</h3>
    <p>{connect.body}</p>
    <GuideRows rows={connect.rows} labels={guide} />
  </li>
</ol>

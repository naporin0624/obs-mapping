---
import { css } from '../../styled-system/css';
import Base from '../layouts/base.astro';

const notFound = css({ maxWidth: '40rem', margin: '0 auto', padding: '64px 16px' });
const actions = css({ display: 'flex', gap: '16px' });
---

<Base lang="ja" title="404 Not Found | obs-mapping" description="Page not found.">
  <div class={notFound}>
    <h1>404</h1>
    <p>ページが見つかりません / Page not found</p>
    <p class={actions}>
      <a href="/">obs-mapping</a>
      <a href="/demo/">Demo</a>
    </p>
  </div>
</Base>


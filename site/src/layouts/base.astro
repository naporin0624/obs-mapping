---
import '../styles/base.css';
import { localePath, messagesFor, type Lang } from '../i18n/messages';

// Without a path the page has no counterpart in the other language and is kept out of search.
type Props = { lang: Lang; path?: string; title: string; description: string };

const { lang, path, title, description } = Astro.props;
const t = messagesFor(lang);
const other: Lang = lang === 'ja' ? 'en' : 'ja';
---

<html lang={t.htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {path === undefined && <meta name="robots" content="noindex" />}
    {
      path !== undefined && (
        <>
          <link rel="alternate" hreflang="ja" href={localePath('ja', path)} />
          <link rel="alternate" hreflang="en" href={localePath('en', path)} />
          <link rel="alternate" hreflang="x-default" href={localePath('ja', path)} />
        </>
      )
    }
  </head>
  <body>
    <header class="site-header">
      <a class="site-name" href={localePath(lang, '/')}>{t.root.title}</a>
      <nav class="site-nav" aria-label={t.langSwitch.label}>
        <a href={localePath(lang, '/demo/')}>{t.demoIndex.title}</a>
        {
          path !== undefined && (
            <a href={localePath(other, path)} hreflang={other} lang={other}>
              {t.langSwitch[other]}
            </a>
          )
        }
      </nav>
    </header>
    <main>
      <slot />
    </main>
  </body>
</html>

<style>
  .site-header {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 8px 24px;
    padding: 12px 16px;
    border-bottom: var(--border-width-default) solid var(--color-border-subtle);
  }

  .site-name {
    color: var(--color-fg-default);
    font-weight: 700;
    text-decoration: none;
  }

  .site-nav {
    display: flex;
    gap: 16px;
  }

  .site-header a {
    display: inline-flex;
    align-items: center;
    min-height: var(--size-target-min);
  }
</style>

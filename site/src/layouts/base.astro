---
import '../styles/layers.css';
import { css } from '../../styled-system/css';
import { localePath, messagesFor, type Lang } from '../i18n/messages';

// Without a path the page has no counterpart in the other language and is kept out of search.
type Props = { lang: Lang; path?: string; title: string; description: string };

const { lang, path, title, description } = Astro.props;
const t = messagesFor(lang);
const other: Lang = lang === 'ja' ? 'en' : 'ja';

const header = css({
  display: 'flex',
  flexWrap: 'wrap',
  alignItems: 'center',
  justifyContent: 'space-between',
  gap: '8px 24px',
  padding: '12px 16px',
  borderBottom: '{borderWidths.default} solid {colors.border.subtle}',
  '& a': { display: 'inline-flex', alignItems: 'center', minHeight: 'target-min' },
});
const siteName = css({ color: 'fg.default', fontWeight: 700, textDecoration: 'none' });
const nav = css({ display: 'flex', gap: '16px' });
---

<html lang={t.htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {path === undefined && <meta name="robots" content="noindex" />}
    {
      path !== undefined && (
        <>
          <link rel="alternate" hreflang="ja" href={localePath('ja', path)} />
          <link rel="alternate" hreflang="en" href={localePath('en', path)} />
          <link rel="alternate" hreflang="x-default" href={localePath('ja', path)} />
        </>
      )
    }
  </head>
  <body>
    <header class={header}>
      <a class={siteName} href={localePath(lang, '/')}>{t.root.title}</a>
      <nav class={nav} aria-label={t.langSwitch.label}>
        <a href={localePath(lang, '/demo/')}>{t.demoIndex.title}</a>
        {
          path !== undefined && (
            <a href={localePath(other, path)} hreflang={other} lang={other}>
              {t.langSwitch[other]}
            </a>
          )
        }
      </nav>
    </header>
    <main>
      <slot />
    </main>
  </body>
</html>


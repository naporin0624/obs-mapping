{
  "name": "obs-mapping-site",
  "version": "0.0.1",
  "private": true,
  "description": "obs-mapping demo site (Astro + three.js)",
  "type": "module",
  "scripts": {
    "prepare": "panda codegen",
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "test": "vitest run --project unit --project browser",
    "test:dist": "astro build && vitest run --project dist",
    "lint": "oxlint --type-aware . && oxfmt --check .",
    "gen:mappings": "tsx scripts/gen-mappings.ts",
    "gen:thumbs": "astro build && tsx scripts/gen-thumbs.ts",
    "typecheck": "tsgo --noEmit",
    "fmt": "oxlint --type-aware . && oxfmt --write .",
    "deploy:install": "pnpm --dir deploy install --frozen-lockfile",
    "deploy:dry": "pnpm build && pnpm --dir deploy exec cf deploy --dry-run",
    "deploy:prod": "pnpm build && pnpm --dir deploy exec cf deploy"
  },
  "dependencies": {
    "astro": "^7.4.5",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@pandacss/dev": "^2.5.0",
    "@pandacss/preset-base": "^2.5.0",
    "@types/culori": "^4.0.1",
    "@types/node": "^26.6.6",
    "@types/three": "^0.187.0",
    "@typescript/native-preview": "7.0.0-dev.20251229.1",
    "@vitest/browser": "^5.1.0",
    "@vitest/browser-playwright": "^5.1.0",
    "culori": "^4.0.2",
    "oxfmt": "^0.76.0",
    "oxlint": "^1.91.0",
    "oxlint-tsgolint": "^7.0.2005",
    "playwright": "^1.64.1",
    "postcss": "^8.5.32",
    "tsx": "^4.23.15",
    "vitest": "^5.1.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
